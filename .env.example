# Port the Express app binds to (must match nginx proxy_pass).
PORT=3000

# 'production' for systemd, 'development' for npm run dev
NODE_ENV=production

# Generate with:
# node -e "require('bcrypt').hash(process.argv[1], 12).then(console.log)" 'change-this-password'
ADMIN_PASSWORD_HASH=$2b$12$replace-with-a-real-bcrypt-hash

# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_COOKIE_SECRET=replace-with-a-strong-random-secret

# ---- Postgres (multi-tenant data plane) --------------------------------
# EITHER a single connection string:
# DATABASE_URL=postgres://blotter:secret@127.0.0.1:5432/blotter
# OR discrete env vars (used when DATABASE_URL is unset):
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=blotter
# PGPASSWORD=secret
# PGDATABASE=blotter
# Pool tuning:
# PG_POOL_MAX=10
# PG_IDLE_MS=30000
# PG_CONNECT_MS=5000

# Kimi / Moonshot AI
KIMI_API_KEY=your_moonshot_api_key_here
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

# CMS target: 'blotter', 'wordpress', or 'webhook'
CMS_TYPE=blotter

# blotter.host Flask CMS (used when CMS_TYPE=blotter)
CMS_BASE_URL=https://blotter.host
CMS_PASSWORD=your_api_key_here

# WordPress REST API (used when CMS_TYPE=wordpress)
CMS_USERNAME=wp_username
WP_POST_STATUS=publish

# Generic webhook (used when CMS_TYPE=webhook)
CMS_WEBHOOK_URL=

# Data sources
RSS_FEED_URLS=https://news.google.com/rss/search?q=Montana+local+news,https://www.montanablotter.com/feed
POLICE_BLOTTER_API_URL=

# Optional default region injected into prompts and tags
DEFAULT_REGION=Montana

# Pipeline tuning
MAX_ENTRIES_PER_RUN=5
SEEN_ITEMS_FILE=/var/lib/blotter-host/seen_items.json
LOG_LEVEL=INFO
